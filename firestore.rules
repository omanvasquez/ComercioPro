rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para identificar al Superadmin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'omanjrvasquez@gmail.com';
    }

    // Función para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // Colección de Tenants (Comercios)
    match /tenants/{tenantId} {
      // Superadmin puede leer y escribir cualquier tenant
      allow read, write: if isSuperAdmin();
      // El dueño del tenant o sus cajeros autorizados pueden leer sus datos
      allow read: if isAuthenticated() && (
        tenantId == request.auth.uid || 
        resource == null || 
        resource.data.ownerEmail == request.auth.token.email ||
        (resource.data.cashierEmails != null && request.auth.token.email in resource.data.cashierEmails)
      );
      allow create: if isAuthenticated() && request.resource.data.ownerEmail == request.auth.token.email;
      allow update: if isSuperAdmin() || (isAuthenticated() && resource.data.ownerEmail == request.auth.token.email);
    }

    // Reglas Multitenant para subcolecciones de cada bodega
    match /tenants/{tenantId}/{collectionName}/{docId} {
      allow read, write: if isSuperAdmin() || (
        isAuthenticated() && (
          tenantId == request.auth.uid ||
          get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerEmail == request.auth.token.email ||
          (get(/databases/$(database)/documents/tenants/$(tenantId)).data.cashierEmails != null &&
           request.auth.token.email in get(/databases/$(database)/documents/tenants/$(tenantId)).data.cashierEmails)
        )
      );
    }
  }
}
