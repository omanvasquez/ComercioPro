# ComercioPro - Configuración de Firebase Independiente
# Crea tu proyecto en la consola de Firebase: https://console.firebase.google.com
# Habilita: Authentication (Google Sign-In) y Cloud Firestore Database

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=comerciopro-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=comerciopro-app
VITE_FIREBASE_STORAGE_BUCKET=comerciopro-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
